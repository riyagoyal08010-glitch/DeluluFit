# Copy to frontend/.env.local for local overrides. Never put secrets here:
# every VITE_* value is compiled into the public JavaScript bundle.

# Origin of the DeluluFit API. Leave empty to call the same origin as the app
# (development uses the Vite proxy below; production should serve the API
# under the same origin or set this to its https URL).
VITE_API_BASE_URL=

# Development only: where the Vite dev server forwards /api requests.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
