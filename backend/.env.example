# Copy to backend/.env and fill in local values. Never commit backend/.env.
# Every setting is optional unless noted; defaults live in app/core/config.py.

ENVIRONMENT=development          # development | test | production
LOG_LEVEL=INFO

# Database (PostgreSQL 14+). postgres:// and postgresql:// URLs are accepted.
DATABASE_URL=postgresql+psycopg://delulufit:CHANGE_ME@127.0.0.1:5432/delulufit
# Disposable database used by the test suite. It is WIPED by every test run,
# and the database name must contain "test".
TEST_DATABASE_URL=postgresql+psycopg://delulufit:CHANGE_ME@127.0.0.1:5432/delulufit_test

# Sessions and cookies. Set COOKIE_SECURE=true whenever the API is served over HTTPS.
SESSION_TTL_HOURS=336
COOKIE_SECURE=false
COOKIE_SAMESITE=lax              # lax | strict | none (none requires COOKIE_SECURE=true)
# COOKIE_DOMAIN=

# Exact frontend origins, comma-separated.
CORS_ORIGINS=http://localhost:5173

# Menu image storage: local | s3
STORAGE_BACKEND=local
# LOCAL_STORAGE_DIR=var/uploads
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT_URL=

# Menu extraction (not implemented yet; keep disabled).
EXTRACTION_PROVIDER=disabled     # disabled | anthropic
# ANTHROPIC_API_KEY=
RUN_INLINE_WORKER=true
