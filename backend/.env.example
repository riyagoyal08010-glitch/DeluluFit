# Copy to backend/.env and fill in local values. Never commit backend/.env.
# Every setting is optional unless noted; defaults live in app/core/config.py.

ENVIRONMENT=development          # development | test | production
LOG_LEVEL=INFO

# Database (PostgreSQL 14+). postgres:// and postgresql:// URLs are accepted.
DATABASE_URL=postgresql+psycopg://delulufit:CHANGE_ME@127.0.0.1:5432/delulufit
# Disposable database used by the test suite. It is WIPED by every test run,
# and the database name must contain "test".
TEST_DATABASE_URL=postgresql+psycopg://delulufit:CHANGE_ME@127.0.0.1:5432/delulufit_test

# Sessions and cookies. Set COOKIE_SECURE=true whenever the API is served over HTTPS.
SESSION_TTL_HOURS=336
COOKIE_SECURE=false
COOKIE_SAMESITE=lax              # lax | strict | none (none requires COOKIE_SECURE=true)
# COOKIE_DOMAIN=

# Exact frontend origins, comma-separated.
CORS_ORIGINS=http://localhost:5173

# Menu image storage: local | s3. Images are private: there is no public URL; the
# owner fetches them through GET /api/v1/menus/{id}/image. Local files default to
# backend/var/uploads (gitignored, outside the frontend). An S3 bucket must block
# public access.
STORAGE_BACKEND=local
# LOCAL_STORAGE_DIR=var/uploads
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT_URL=
# S3_PREFIX=menu-uploads/

# Menu photo limits. Larger uploads get 413 upload_too_large; images over the
# pixel limit get 422 image_too_large. Stored copies are re-encoded as JPEG with
# the longest side capped and all metadata (EXIF/GPS) removed.
MAX_UPLOAD_BYTES=8388608         # 8 MB, the size of the uploaded file
MAX_IMAGE_PIXELS=40000000        # width x height, decompression-bomb guard
NORMALIZED_IMAGE_MAX_SIDE=2400   # px, longest side of the stored copy
UPLOAD_RATE_LIMIT_PER_HOUR=30    # per student per hour, each for uploads and extraction starts (per process)

# Menu extraction (not implemented yet; keep disabled).
EXTRACTION_PROVIDER=disabled     # disabled | anthropic
# ANTHROPIC_API_KEY=
RUN_INLINE_WORKER=true
